{
  "allowedExactPaths": [
    "404.html",
    "404/index.html",
    "CNAME",
    "favicon.svg",
    "index.html",
    "og.png",
    "og-2026-10-19.svg",
    "rss.xml",
    "tldr-macro-logo-wide.png",
    "_not-found/index.html"
  ],
  "allowedPrefixes": {
    "_next/static/": [".css", ".js", ".woff2"],
    "_not-found/": [".html", ".txt"],
    "404/": [".html", ".txt"]
    ,"about/": [".html", ".txt"]
    ,"glossary/": [".html", ".txt"]
    ,"archive/": [".html", ".txt"]
  },
  "allowedRootPatterns": [
    "^og-\\d{4}-\\d{2}-\\d{2}\\.png$",
    "^__next\\..+\\.txt$",
    "^index\\.txt$"
  ],
  "forbiddenSegments": [
    ".git",
    ".github",
    ".next",
    "config",
    "data",
    "docs",
    "node_modules",
    "reports",
    "scripts",
    "tests"
  ],
  "forbiddenBasenames": [
    ".env",
    "thread-approvals.json",
    "THREAD_REPORT.md",
    "THREAD_RECHECK.md",
    "package-lock.json",
    "package.json"
  ],
  "forbiddenExtensions": [
    ".key",
    ".map",
    ".md",
    ".pem"
  ]
}
