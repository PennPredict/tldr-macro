{
  "brand": "TL;DR Macro",
  "slogan": "Market intelligence for everyone.",
  "audience": "Readers with no assumed finance or economics background",
  "style": {
    "banned_words": ["because", "relieved", "overwhelm", "must"],
    "banned_phrases": ["you should", "consider buying", "consider selling", "good time to", "safe bet", "opportunity", "avoid", "we expect", "bullish", "bearish", "buy rating", "sell rating", "hold rating", "price target", "guaranteed return", "will cause", "will rise", "will fall", "undervalued", "overvalued", "shrugged off", "fears eased", "cost pressure", "price pressure", "packaging pressure", "rate pressure", "rate resilience", "showed that", "shows how", "historically associated", "hotter / tighter", "cooler / easier"],
    "banned_characters": ["—"],
    "avoid_repeating_numbers_already_in_visuals": true,
    "define_acronyms_on_first_use": true,
    "connect_to_everyday_life": true,
    "distinguish_fact_from_inference": true,
    "require_visible_source_links": true
  }
}
