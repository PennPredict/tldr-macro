{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"array",
  "items":{
    "type":"object",
    "required":["topic_tag","headline","commentary","defines","visual","views","sources"],
    "properties":{
      "topic_tag":{"type":"string"},
      "headline":{"type":"string","maxLength":80},
      "commentary":{"type":"string"},
      "defines":{"type":"array","minItems":1,"items":{"type":"object","required":["term","definition","used_by_and_why"]}},
      "visual":{"type":"object","required":["type","data","as_of","source","caption","alt"]},
      "views":{"type":"array","minItems":2,"maxItems":3,"items":{"type":"object","required":["view_id","body","keep_wondering"]}},
      "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["name","href"]}},
      "expected_vs_actual":{"type":"object","required":["forecast","actual","prior"]},
      "data_note":{"type":"string"}
    }
  }
}
