{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:review": "node scripts/review-audit.mjs",
    "build": "npm run validate:content && vinext build && npm run test:popovers",
    "build:pages": "npm run validate:content && npm run validate:review && next build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .security --ignore-pattern out --ignore-pattern publish",
    "test:popovers": "node scripts/test-popovers.mjs",
    "test:acceptance": "node scripts/test-acceptance.mjs"
    ,"test:terms": "node scripts/test-term-matcher.mjs"
    ,"test:status": "node scripts/test-edition-status.mjs"
    ,"test:browser-integrity": "node scripts/test-browser-integrity.mjs"
    ,"test:url-sanitizer": "node scripts/test-url-sanitizer.mjs"
    ,"test:outsider": "node scripts/test-outsider-local.mjs"
    ,"security:prepare": "node scripts/prepare-publish.mjs out publish"
    ,"security:scan": "node scripts/security-check.mjs"
    ,"security:gitleaks": "node scripts/run-gitleaks.mjs"
    ,"verify:guardrails": "node scripts/verify-guardrails.mjs"
    ,"thread:prepare": "node scripts/validate-thread.mjs"
    ,"normalize:markets": "node scripts/normalize-market-series.mjs"
    ,"validate:markets": "node scripts/validate-market-series.mjs"
    ,"thread:review": "node scripts/thread-review.mjs"
    ,"thread:approve": "node scripts/thread-approve.mjs"
    ,"thread:recheck": "node scripts/thread-recheck.mjs"
    ,"test:mortgage": "node scripts/test-mortgage-math.mjs"
    ,"validate:thread": "node scripts/validate-thread.mjs"
    ,"verify": "npm run validate:content && npm run validate:markets && npm run validate:thread && npm run test:mortgage && npm run thread:prepare && npm run validate:review && npm run verify:guardrails && npm run test:terms && npm run test:status && npm run lint && npm run build:pages && npm run security:prepare && npm run test:url-sanitizer && npm run security:scan && npm run security:gitleaks && npm run test:browser-integrity && npm run test:outsider"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.55.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
